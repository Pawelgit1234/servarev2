DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=servarev2

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=60

S3_ROOT_USER=minioadmin
S3_ROOT_PASSWORD=minioadmin
S3_PUBLIC_ENDPOINT=http://localhost:9000

IP_CHECK_INTERVAL_DAYS=30
PORTER_CHECK_INTERVAL_DAYS=2

MASSCAN_RATE=1000
MASSCAN_RATE_TARGET=1000
PORTER_BATCH_SIZE=10

CHECKER_WORKERS=20
CHECKER_PORT_CONCURRENCY=100

MONITOR_SERVER_WORKERS=10
MONITOR_PLAYER_WORKERS=10


DB_RETRY_DELAY_SECONDS=10

API_MAX_ATTEMPTS=5
API_BASE_DELAY_SECONDS=1
API_MAX_DELAY_SECONDS=30

WORKER_RESTART_ON_FAILURE_DELAY=1

SERVER_CHECK_TIMEOUT=3
AIOHTTP_TIMEOUT=10
# IPINFO_API_TOKEN=<your-token>

BOT_WORKERS=1
BOT_IDLE_TIMEOUT=5
BOT_CONNECT_TIMEOUT=10
BOT_MAX_LIFETIME=60
BOT_NAME_PREFIX=SV2_
BOT_SPAWN_MESSAGE="Hello! This server is currently being checked by the ServareV2 project. This is a routine automated scan used to collect basic information about the server and its configuration. Please don't worry — the scan is harmless and does not modify or interfere with your world, players, or server settings. Thank you for your patience!"
